rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == "active";
    }

    function isActivePublicUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "public"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == "active";
    }

    match /users/{userId} {

      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == "public";

      allow update: if isAdmin()
        || (
          request.auth != null
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.accountStatus == resource.data.accountStatus
        );

      allow delete: if isAdmin();
    }

    match /single_phase_motors/{motorId} {

      allow read: if isAdmin()
        || (
          request.auth != null
          && resource.data.status == "approved"
        )
        || (
          request.auth != null
          && resource.data.createdBy == request.auth.uid
        );

      allow create: if isAdmin()
        || (
          isActivePublicUser()
          && request.resource.data.status == "pending"
          && request.resource.data.createdBy == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    match /three_phase_motors/{motorId} {

      allow read: if isAdmin()
        || (
          request.auth != null
          && resource.data.status == "approved"
        )
        || (
          request.auth != null
          && resource.data.createdBy == request.auth.uid
        );

      allow create: if isAdmin()
        || (
          isActivePublicUser()
          && request.resource.data.status == "pending"
          && request.resource.data.createdBy == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }
  }
}
